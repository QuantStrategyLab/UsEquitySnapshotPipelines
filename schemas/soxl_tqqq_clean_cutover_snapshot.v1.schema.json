{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOXL/TQQQ clean-cutover snapshot manifest",
  "description": "Structural constraints only; Python is the authoritative semantic verifier for dates, timestamps, canonical bytes, calendar membership, numeric safety and filesystem state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "pair_id", "symbols", "evidence_generation", "offline_fixture", "plugin", "size", "source_identity", "producer_identity", "generated_at", "coverage", "payload_sha256"],
  "properties": {
    "schema": {"const": "soxl_tqqq_clean_cutover_snapshot.v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "pair_id": {"enum": ["QQQ_TQQQ", "SOXX_SOXL"]},
    "symbols": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "evidence_generation": {"const": "clean_cutover_v1"},
    "offline_fixture": {"const": true},
    "plugin": {"const": "ABSENT_DISABLED"},
    "size": {"const": 0},
    "source_identity": {"type": "string", "minLength": 1},
    "producer_identity": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_sessions", "first_session", "last_session", "per_symbol_counts", "row_count"],
      "properties": {
        "completed_sessions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
        "first_session": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "last_session": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "per_symbol_counts": {"type": "object"},
        "row_count": {"type": "integer", "minimum": 2, "multipleOf": 2}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"pair_id": {"const": "QQQ_TQQQ"}}, "required": ["pair_id"]},
      "then": {
        "properties": {
          "symbols": {"prefixItems": [{"const": "QQQ"}, {"const": "TQQQ"}], "items": false},
          "coverage": {"properties": {"per_symbol_counts": {"type": "object", "additionalProperties": false, "required": ["QQQ", "TQQQ"], "properties": {"QQQ": {"type": "integer", "minimum": 1}, "TQQQ": {"type": "integer", "minimum": 1}}}}}
        }
      }
    },
    {
      "if": {"properties": {"pair_id": {"const": "SOXX_SOXL"}}, "required": ["pair_id"]},
      "then": {
        "properties": {
          "symbols": {"prefixItems": [{"const": "SOXX"}, {"const": "SOXL"}], "items": false},
          "coverage": {"properties": {"per_symbol_counts": {"type": "object", "additionalProperties": false, "required": ["SOXX", "SOXL"], "properties": {"SOXX": {"type": "integer", "minimum": 1}, "SOXL": {"type": "integer", "minimum": 1}}}}}
        }
      }
    }
  ]
}
