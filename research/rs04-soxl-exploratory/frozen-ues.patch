+def _accounting_action_id(row: Mapping, symbol: str, seen_ids: set[str]) -> str | None:
+    # The producer permits an absent symbol; an explicit mismatch is unusable.
+    if row.get("symbol") not in (None, symbol):
+        raise PrivateRunError(f"ACTION_SYMBOL_MISMATCH:{symbol}")
+    if row.get("currency", "USD") != "USD":
+        raise PrivateRunError(f"ACTION_CURRENCY_UNSUPPORTED:{symbol}")
+    revision_fields = ("cancelled", "canceled", "replaced_by", "replaces", "superseded_by", "replacement_id", "revision")
+    if row.get("status", "active") != "active" or any(row.get(field) for field in revision_fields):
+        raise PrivateRunError(f"ACTION_REVISION_UNSUPPORTED:{symbol}")
+    native_id = row.get("id")
+    if native_id is not None:
+        if not isinstance(native_id, str) or not 0 < len(native_id) <= 256 or native_id != native_id.strip():
+            raise PrivateRunError(f"ACTION_ID_INVALID:{symbol}")
+        if native_id in seen_ids:
+            raise PrivateRunError(f"ACTION_ID_DUPLICATE:{symbol}")
+        seen_ids.add(native_id)
+    return native_id
+
+
