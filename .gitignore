.venv/
build/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
# Ephemeral Workload Identity Federation credentials generated by
# google-github-actions/auth inside the GitHub Actions checkout.  They are
# removed by the action after each job and must not make the immutable runner
# source checkout appear modified during P3 verification.
gha-creds-*.json
data/output/*
!data/output/.gitkeep
data/input/*
!data/input/.gitkeep

# Keep AI rule files and shared engineering conventions tracked even when a
# personal global ignore excludes Markdown.
!AGENTS.md
!CLAUDE.md
!.github/engineering.md

# Section 6 of the organization style guide: notes that must stay out of Git.
.local/
ops-notes/
*.local.md
*.internal.md

# Process notes stay out of the repository, see section 5.
# An audit, a handoff or a review describes one moment; the code moves on and
# the document does not, so what is left behind reads as current long after it
# stopped being true. Commit history is where to look instead. The [Aa]
# spelling is because .gitignore is case-sensitive on some platforms.
*[Aa][Uu][Dd][Ii][Tt]*.md
*[Hh][Aa][Nn][Dd][Oo][Ff][Ff]*.md
*-[Rr][Ee][Vv][Ii][Ee][Ww]-*.md
*_[Rr][Ee][Vv][Ii][Ee][Ww]_*.md
docs/audits/
docs/plans/
docs/handoffs/
docs/superpowers/
